.dmypy.json
dmypy.json
.pytype/
.pyre/

# ─── Frontend ────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/coverage/

# ─── Docker ───────────────────────────────────────────────────────────────────
.docker/

